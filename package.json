{
  "name": "proxima-backpack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proxima Backpack — a standalone Elastic board, Schedule and projects app",
  "scripts": {
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc -p tsconfig.build.json",
    "agent:bridge": "node tools/agent-vault-bridge.mjs",
    "agent:accept": "node tools/agent-accept.mjs",
    "agent:coexist": "node tools/coexistence-run.mjs",
    "agent:visual": "node tools/papers-visual-accept.mjs",
    "probe:containment": "node tools/containment-probe.mjs",
    "probe:fsa-handle": "node tools/fsa-native-handle-probe.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "happy-dom": "15.11.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
